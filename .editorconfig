root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,cppm,h,cc,cxx}]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

[*.lua]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{sh,bash}]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
